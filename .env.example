# ─────────────────────────────────────────────────────────────
# 네이버 클라우드 플랫폼(NCP) - Maps
# 콘솔: https://console.ncloud.com/naver-service/application
#
# 1) "Application 등록" → Maps 선택, "Web Dynamic Map" 체크
# 2) "Web 서비스 URL" 에 아래 두 개를 등록
#      http://localhost:3000
#      https://donsnote.github.io
# 3) 발급된 Client ID 를 .env.local 에 입력 (이 파일에는 실제 값 넣지 말 것)
# ─────────────────────────────────────────────────────────────

# 지도 렌더링에 필요한 값 (브라우저에 노출됨 - 도메인 제한으로 보호)
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=

# 인증 파라미터 이름. 신규(2024년 이후) 키는 ncpKeyId, 구버전 키는 ncpClientId.
# 지도가 안 뜨면 이 값을 ncpClientId 로 바꿔서 다시 시도.
NEXT_PUBLIC_NAVER_MAP_AUTH_PARAM=ncpKeyId

# Client Secret 은 Geocoding / Directions 같은 "서버 API" 전용입니다.
# 이 팜플렛의 지도에는 필요 없습니다. 필요해지면 .env.local 에만 넣으세요.
# NAVER_MAP_CLIENT_SECRET=
